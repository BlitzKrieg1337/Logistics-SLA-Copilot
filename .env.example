# --- API Keys & External Services ---
TAVILY_API_KEY=your_tavily_api_key_here
GEMINI_API_KEY=your_gemini_api_key_here
GROQ_API_KEY=your_groq_api_key_here
OPENROUTER_API_KEY=your_openrouter_api_key_here
PINECONE_API_KEY=your_pinecone_api_key_here
LANGSMITH_API_KEY=your_langsmith_api_key_here

# --- Database Configurations ---
# Format: postgresql://user:password@localhost:1234/dbname
DATABASE_URL=postgresql://postgres:password@localhost:1234/logistics_db
READONLY_DATABASE_URL=postgresql://readonly_user:password@localhost:1234/logistics_db
UPDATEONLY_DATABASE_URL=postgresql://update_user:password@localhost:1234/logistics_db

# --- Database Roles & Credentials ---
READONLY_ROLE=logistics_readonly_role
READONLY_PASSWORD=secure_readonly_password_placeholder

UPDATE_ROLE=logistics_update_role
UPDATE_PASSWORD=secure_update_password_placeholder

# --- Frontend & Network Settings ---
VITE_API_BASE= http://localhost:8000
CORS_ORIGINS= http://localhost:5173,http://localhost:3000
